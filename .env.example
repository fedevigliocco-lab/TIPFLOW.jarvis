# Database Postgres (es. Neon). Se vuoto, in locale si usa un database nel file .data/
DATABASE_URL=

# Chiave dell'API di Claude (console.anthropic.com). Serve solo per far girare gli agenti.
ANTHROPIC_API_KEY=

# Modello usato dagli agenti. Lasciare vuoto per il predefinito (claude-opus-5-5).
# Per spendere meno sui compiti semplici: claude-haiku-5-5
JARVIS_MODEL=

# Password per entrare nel pannello (obbligatoria online)
JARVIS_PASSWORD=

# Segreto per le chiamate programmate (cron) a /api/agenti/<nome>
CRON_SECRET=
